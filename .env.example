# SMTP Configuration for OTP Email Sending
# These settings are required for the OTP system to send emails

# Gmail Configuration (recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=collaboration.tdtpowersteel@gmail.com
SMTP_PASS=your-app-password-here

# Alternative: Other email providers
# SMTP_HOST=smtp.outlook.com
# SMTP_HOST=smtp.yahoo.com

# Email sender details
EMAIL_FROM=collaboration.tdtpowersteel@gmail.com

# Server port (optional, defaults to dynamic)
PORT=3001

# Frontend API Configuration
# Set this to the backend host used by the Vite frontend in development.
VITE_API_BASE=http://localhost:3001